{
  "expo": {
    "name": "Stedfast",
    "slug": "Stedfast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/stedfast-icon-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/stedfast-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/stedfast-icon-1024.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dev.shriram.ms.stedfastapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "66f22780-ec52-4fe2-97bd-68851d44157c"
      }
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withAdiRegistration.js"
    ]
  }
}
